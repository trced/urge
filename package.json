{
  "name": "urge",
  "version": "0.1.0",
  "private": true,
  "description": "One urge. Thirty days. One question. A local-first, offline register of what you did not buy.",
  "keywords": [
    "mindful-spending",
    "impulse",
    "local-first",
    "offline",
    "pwa",
    "privacy",
    "no-tracking"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/trced/urge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trced/urge.git"
  },
  "bugs": {
    "url": "https://github.com/trced/urge/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
